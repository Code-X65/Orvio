{
  "name": "@orvio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:test": "vitest run tests/integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.3.4",
    "@prisma/client": "^6.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.41.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.0.0",
    "prisma": "^6.4.0",
    "testcontainers": "^11.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
