NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
CORS_ORIGINS=http://localhost:4000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-secure-random-32-character-secret-before-deploying
JWT_SECRET_PREVIOUS=
EMAIL_LINK_SECRET=generate-a-separate-secure-random-32-character-secret-before-deploying
COOKIE_SECURE=false
FRONTEND_APP_URL=http://localhost:4000
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Orvio
PUBLIC_API_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_URL=https://graph.facebook.com
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_IP_MAX=30
AUTH_RATE_LIMIT_REGISTRATION_MAX=5
AUTH_RATE_LIMIT_REGISTRATION_WINDOW_MS=900000
AUTH_RATE_LIMIT_REGISTRATION_IP_MAX=30
AUTH_RATE_LIMIT_OTP_MAX=3
AUTH_RATE_LIMIT_OTP_WINDOW_MS=600000
AUTH_RATE_LIMIT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_PASSWORD_WINDOW_MS=900000
AUTH_RATE_LIMIT_PASSWORD_IP_MAX=30
AUTH_SESSION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=1825
AUTH_CLEANUP_INTERVAL_MS=3600000
# E2E_TEST_MODE=true is test-only and requires a 32+ character capture secret.
E2E_TEST_MODE=false
E2E_CAPTURE_SECRET=
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=Orvio
TERMII_BASE_URL=https://api.ng.termii.com
