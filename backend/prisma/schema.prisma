datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum user_status {
  active
  suspended
  deleted
}

enum org_status {
  pending
  active
  suspended
  deleted
}

enum membership_role {
  owner
  admin
  manager
  member
}

enum membership_status {
  active
  invited
  suspended
}

enum branch_type {
  store
  warehouse
  studio
  headquarters
}

enum branch_status {
  active
  inactive
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password_hash     String
  full_name         String
  phone             String?
  status            user_status         @default(active)
  email_verified_at DateTime?
  last_login_at     DateTime?
  last_login_ip     String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  memberships       Membership[]
  verification_tokens VerificationToken[]
  refresh_tokens    RefreshToken[]

  @@index([phone])
  @@map("users")
}


model Organization {
  id              String       @id @default(cuid())
  name            String
  subdomain       String       @unique
  status          org_status   @default(pending)
  timezone        String       @default("Africa/Lagos")
  currency        String       @default("NGN")
  country         String       @default("NG")
  business_type   String?
  description     String?
  logo_url        String?
  business_email  String?
  phone           String?
  website         String?
  plan_code       String?      @default("free")
  trial_ends_at   DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  memberships     Membership[]
  branches        Branch[]
  products        WorkspaceProduct[]
  invitations     WorkspaceInvitation[]
  onboarding_flow OnboardingFlow?

  @@map("organizations")
}

model Membership {
  id          String            @id @default(cuid())
  org_id      String
  user_id     String
  role        membership_role   @default(member)
  status      membership_status @default(active)
  invited_at  DateTime?
  accepted_at DateTime?         @default(now())
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@map("user_memberships")
}

model Branch {
  id          String        @id @default(cuid())
  org_id      String
  name        String
  type        branch_type   @default(store)
  status      branch_status @default(active)
  product_key String?       @default("inventory")
  is_primary  Boolean       @default(true)
  phone       String?
  email       String?
  address     Json?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@map("branches")
}

model WorkspaceProduct {
  id          String   @id @default(cuid())
  org_id      String
  product_key String
  status      String   @default("active")
  is_primary  Boolean  @default(false)
  settings    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, product_key])
  @@map("workspace_products")
}

model WorkspaceInvitation {
  id            String          @id @default(cuid())
  org_id        String
  email         String
  role          membership_role @default(member)
  product_roles Json?
  branch_ids    Json?
  token_hash    String          @unique
  status        String          @default("pending")
  invited_by_id String
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@map("workspace_invitations")
}

model OnboardingFlow {
  id           String    @id @default(cuid())
  org_id       String    @unique
  flow_type    String    @default("organization")
  current_step String    @default("organization_basics")
  step_data    Json?
  status       String    @default("in_progress")
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("onboarding_flows")
}

model VerificationToken {
  id          String    @id @default(cuid())
  user_id     String
  token_hash  String    @unique
  purpose     String    @default("email_verification")
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("verification_tokens")
}

model RefreshToken {
  id          String    @id @default(cuid())
  user_id     String
  org_id      String?
  membership_id String?
  session_id   String?
  absolute_expires_at DateTime?
  last_used_at DateTime?
  created_ip   String?
  user_agent   String?
  family_id   String?
  token_hash  String    @unique
  jti         String    @unique
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([membership_id])
  @@index([session_id])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id               String   @id @default(cuid())
  key              String   @unique
  request_path     String
  request_method   String
  request_hash     String
  status           String   @default("in_progress") // in_progress | completed | failed
  status_code      Int?
  response_headers Json?
  response_body    Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  expires_at       DateTime

  @@index([key])
  @@index([expires_at])
  @@map("idempotency_keys")
}
