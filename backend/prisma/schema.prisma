datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum user_status {
  active
  suspended
  deleted
}

enum org_status {
  pending
  active
  suspended
  deleted
}

enum membership_role {
  owner
  admin
  manager
  member
}

enum membership_status {
  active
  invited
  suspended
}

enum branch_type {
  store
  warehouse
  studio
  headquarters
}

enum branch_status {
  active
  inactive
}

enum measurement_unit {
  pcs
  kg
  g
  liter
  ml
  box
  pack
  bottle
  dozen
}

enum stock_movement_type {
  opening
  receipt
  adjustment
  transfer_out
  transfer_in
  sale
  sale_void
}

enum stock_adjustment_reason {
  damage
  loss
  found
  correction
  count_reconciliation
  other
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password_hash     String
  full_name         String
  phone             String?
  status            user_status         @default(active)
  email_verified_at DateTime?
  phone_verified_at DateTime?
  last_login_at     DateTime?
  last_login_ip     String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  memberships       Membership[]
  verification_tokens VerificationToken[]
  refresh_tokens    RefreshToken[]
  audit_logs        AuditLog[]
  branch_products_added BranchProduct[] @relation("BranchProductAddedBy")
  catalog_imports_imported CatalogImport[] @relation("CatalogImportImportedBy")
  stock_movements_authored StockMovement[] @relation("StockMovementActor")
  suppliers_created        Supplier[]      @relation("SupplierCreatedBy")
  stock_receipts_created   StockReceipt[]  @relation("ReceiptCreatedBy")
  stock_receipts_received  StockReceipt[]  @relation("ReceiptReceivedBy")

  @@index([phone])
  @@map("users")
}


model Organization {
  id              String       @id @default(cuid())
  name            String
  subdomain       String       @unique
  status          org_status   @default(pending)
  timezone        String       @default("Africa/Lagos")
  currency        String       @default("NGN")
  country         String       @default("NG")
  business_type   String?
  description     String?
  logo_url        String?
  business_email  String?
  phone           String?
  website         String?
  plan_code       String?      @default("free")
  trial_ends_at   DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  memberships          Membership[]
  branches             Branch[]
  products             WorkspaceProduct[]
  invitations          WorkspaceInvitation[]
  onboarding_flow      OnboardingFlow?
  inventory_onboarding InventoryOnboarding?
  categories           Category[]
  brands               Brand[]
  catalog_products     Product[]
  product_variants     ProductVariant[]
  branch_products      BranchProduct[]
  catalog_imports      CatalogImport[]
  stock_levels         StockLevel[]
  stock_movements      StockMovement[]
  price_histories      ProductPriceHistory[]
  audit_logs           AuditLog[]
  product_images       ProductImage[]
  suppliers            Supplier[]
  stock_receipts       StockReceipt[]

  @@map("organizations")
}

model Membership {
  id          String            @id @default(cuid())
  org_id      String
  user_id     String
  role        membership_role   @default(member)
  status      membership_status @default(active)
  invited_at  DateTime?
  accepted_at DateTime?         @default(now())
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@map("user_memberships")
}

model Branch {
  id                    String                @id @default(cuid())
  org_id                String
  name                  String
  code                  String?
  type                  branch_type           @default(store)
  status                branch_status         @default(active)
  product_key           String?               @default("inventory")
  is_primary            Boolean               @default(true)
  phone                 String?
  email                 String?
  address               Json?
  is_deleted            Boolean               @default(false)
  deleted_at            DateTime?
  deleted_by_user_id    String?
  deleted_reason        String?               @db.Text
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  organization          Organization          @relation(fields: [org_id], references: [id], onDelete: Cascade)
  inventory_onboardings InventoryOnboarding[]
  stock_levels          StockLevel[]
  stock_movements       StockMovement[]
  branch_products       BranchProduct[]       @relation("BranchProductAssignment")
  sourced_branch_products BranchProduct[]     @relation("BranchProductSource")
  imports_received      CatalogImport[]       @relation("ImportTarget")
  imports_sourced       CatalogImport[]       @relation("ImportSource")
  categories            Category[]            @relation("BranchCategories")
  brands                Brand[]               @relation("BranchBrands")
  stock_receipts        StockReceipt[]

  @@index([org_id])
  @@index([org_id, is_deleted])
  @@map("branches")
}

model WorkspaceProduct {
  id          String   @id @default(cuid())
  org_id      String
  product_key String
  status      String   @default("active")
  is_primary  Boolean  @default(false)
  settings    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, product_key])
  @@map("workspace_products")
}

model WorkspaceInvitation {
  id            String          @id @default(cuid())
  org_id        String
  email         String
  role          membership_role @default(member)
  product_roles Json?
  branch_ids    Json?
  token_hash    String          @unique
  status        String          @default("pending")
  invited_by_id String
  expires_at    DateTime
  accepted_at   DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@map("workspace_invitations")
}

model OnboardingFlow {
  id           String    @id @default(cuid())
  org_id       String    @unique
  flow_type    String    @default("organization")
  current_step String    @default("organization_basics")
  step_data    Json?
  status       String    @default("in_progress")
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("onboarding_flows")
}

model InventoryOnboarding {
  id           String    @id @default(cuid())
  org_id       String    @unique
  branch_id    String?
  status       String    @default("pending") // pending | completed
  step_data    Json?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([org_id])
  @@index([branch_id])
  @@map("inventory_onboardings")
}

model VerificationToken {
  id          String    @id @default(cuid())
  user_id     String
  token_hash  String    @unique
  purpose     String    @default("email_verification")
  metadata    Json?
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("verification_tokens")
}

model RefreshToken {
  id          String    @id @default(cuid())
  user_id     String
  org_id      String?
  membership_id String?
  session_id   String?
  absolute_expires_at DateTime?
  last_used_at DateTime?
  created_ip   String?
  user_agent   String?
  family_id   String?
  token_hash  String    @unique
  jti         String    @unique
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([membership_id])
  @@index([session_id])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id               String   @id @default(cuid())
  key              String   @unique
  request_path     String
  request_method   String
  request_hash     String
  status           String   @default("in_progress") // in_progress | completed | failed
  status_code      Int?
  response_headers Json?
  response_body    Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  expires_at       DateTime

  @@index([key])
  @@index([expires_at])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  org_id     String?
  event      String
  status     String   @default("success") // success | failed
  ip_address String?
  user_agent String?
  metadata   Json?
  created_at DateTime @default(now())

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([org_id])
  @@index([event])
  @@index([created_at])
  @@map("audit_logs")
}

model Category {
  id            String    @id @default(cuid())
  org_id        String
  name          String
  slug          String
  description   String?
  image_url     String?
  parent_id     String?
  sort_order    Int       @default(0)
  is_active     Boolean   @default(true)
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  organization  Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch_id     String
  branch        Branch        @relation("BranchCategories", fields: [branch_id], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children      Category[]    @relation("CategoryHierarchy")
  products           Product[]
  branch_products    BranchProduct[] @relation("BranchProductCategory")

  @@unique([org_id, branch_id, slug])
  @@index([org_id])
  @@index([branch_id])
  @@index([org_id, branch_id])
  @@index([org_id, is_deleted])
  @@index([parent_id])
  @@map("categories")
}

model Product {
  id                  String                @id @default(cuid())
  org_id              String
  category_id         String?
  name                String
  description         String?               @db.Text
  sku                 String
  barcode             String?
  cost_price          Decimal               @db.Decimal(12, 2)
  selling_price       Decimal               @db.Decimal(12, 2)
  compare_at_price    Decimal?              @db.Decimal(12, 2)
  unit_of_measure     measurement_unit      @default(pcs)
  track_quantity      Boolean               @default(true)
  low_stock_threshold Int                   @default(0)
  has_variants        Boolean               @default(false)
  image_url           String?
  is_active           Boolean               @default(true)
  is_deleted          Boolean               @default(false)
  deleted_at          DateTime?
  deleted_by_user_id  String?
  deleted_reason      String?               @db.Text
  business_type       String?
  metadata            Json?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  organization        Organization          @relation(fields: [org_id], references: [id], onDelete: Cascade)
  category            Category?             @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brand_id            String?
  brand               Brand?                @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  images              ProductImage[]
  stock_levels        StockLevel[]
  stock_movements     StockMovement[]
  price_history       ProductPriceHistory[]
  branch_assignments  BranchProduct[]
  stock_receipt_items StockReceiptItem[]

  @@unique([org_id, sku])
  @@index([org_id])
  @@index([category_id])
  @@index([brand_id])
  @@index([is_active, is_deleted])
  @@index([org_id, is_deleted])
  @@map("products")
}

model ProductVariant {
  id                  String                @id @default(cuid())
  org_id              String
  product_id          String
  sku                 String
  barcode             String?
  cost_price          Decimal               @db.Decimal(12, 2)
  selling_price       Decimal               @db.Decimal(12, 2)
  compare_at_price    Decimal?              @db.Decimal(12, 2)
  attributes          Json
  low_stock_threshold Int?
  is_active           Boolean               @default(true)
  is_deleted          Boolean               @default(false)
  deleted_at          DateTime?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  organization        Organization          @relation(fields: [org_id], references: [id], onDelete: Cascade)
  product             Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images              ProductImage[]
  stock_levels        StockLevel[]
  stock_movements     StockMovement[]
  price_history       ProductPriceHistory[]
  stock_receipt_items StockReceiptItem[]

  @@unique([org_id, sku])
  @@index([org_id, barcode])
  @@index([product_id])
  @@index([product_id, is_deleted])
  @@index([org_id])
  @@map("product_variants")
}

model ProductImage {
  id             String          @id @default(cuid())
  org_id         String
  product_id     String
  variant_id     String?
  url            String
  thumbnail_200  String?
  thumbnail_400  String?
  thumbnail_800  String?
  thumbnail_1200 String?
  alt_text       String?
  sort_order     Int             @default(0)
  is_primary     Boolean         @default(false)
  file_size      Int?
  mime_type      String?
  created_at     DateTime        @default(now())

  organization   Organization    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@index([product_id])
  @@index([product_id, variant_id])
  @@index([product_id, is_primary])
  @@map("product_images")
}

model ProductPriceHistory {
  id                 String          @id @default(cuid())
  org_id             String
  product_id         String
  variant_id         String?
  old_cost_price     Decimal         @db.Decimal(12, 2)
  new_cost_price     Decimal         @db.Decimal(12, 2)
  old_selling_price  Decimal         @db.Decimal(12, 2)
  new_selling_price  Decimal         @db.Decimal(12, 2)
  reason             String?         @db.Text
  changed_by_user_id String?
  created_at         DateTime        @default(now())

  organization       Organization    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([org_id, product_id])
  @@index([variant_id])
  @@map("product_price_histories")
}

model StockLevel {
  id                  String          @id @default(cuid())
  org_id              String
  product_id          String?
  variant_id          String?
  branch_id           String
  quantity_on_hand    Decimal         @default(0) @db.Decimal(14, 3)
  reserved            Decimal         @default(0) @db.Decimal(14, 3)
  low_stock_threshold Int?
  updated_at          DateTime        @updatedAt

  organization        Organization    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  branch              Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([org_id, variant_id, branch_id])
  @@index([org_id, product_id, branch_id])
  @@index([org_id])
  @@index([branch_id])
  @@map("stock_levels")
}

model StockMovement {
  id               String                   @id @default(cuid())
  org_id           String
  branch_id        String
  product_id       String
  variant_id       String?
  movement_type    stock_movement_type
  quantity         Decimal                  @db.Decimal(14, 3)
  balance_before   Decimal                  @db.Decimal(14, 3)
  balance_after    Decimal                  @db.Decimal(14, 3)
  reason           stock_adjustment_reason?
  reference_id     String?
  actor_id         String?
  stock_receipt_id String?
  notes            String?                  @db.Text
  metadata         Json?
  created_at       DateTime                 @default(now())

  organization     Organization             @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch           Branch                   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product          Product                  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant          ProductVariant?          @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  actor            User?                    @relation("StockMovementActor", fields: [actor_id], references: [id], onDelete: SetNull)
  stock_receipt    StockReceipt?            @relation(fields: [stock_receipt_id], references: [id], onDelete: SetNull)

  @@index([org_id, branch_id])
  @@index([org_id, product_id])
  @@index([org_id, movement_type])
  @@index([org_id, created_at])
  @@index([reference_id])
  @@index([stock_receipt_id])
  @@map("stock_movements")
}

model Brand {
  id                 String    @id @default(cuid())
  org_id             String
  name               String
  slug               String
  description        String?   @db.Text
  logo_url           String?
  website_url        String?
  is_active          Boolean   @default(true)
  is_deleted         Boolean   @default(false)
  deleted_at         DateTime?
  deleted_by_user_id String?
  deleted_reason     String?   @db.Text
  sort_order         Int       @default(0)
  metadata           Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization       Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch_id          String
  branch             Branch       @relation("BranchBrands", fields: [branch_id], references: [id], onDelete: Cascade)
  products           Product[]
  branch_products    BranchProduct[] @relation("BranchProductBrand")

  @@unique([org_id, branch_id, slug])
  @@index([org_id])
  @@index([branch_id])
  @@index([org_id, branch_id])
  @@index([org_id, is_deleted])
  @@index([org_id, is_active])
  @@map("brands")
}

model BranchProduct {
  id                    String       @id @default(cuid())
  org_id                String
  branch_id             String
  product_id            String
  category_id           String?
  brand_id              String?
  source_branch_id      String?
  added_by_user_id      String?
  added_at              DateTime     @default(now())
  notes                 String?      @db.Text
  is_excluded           Boolean      @default(false)

  organization          Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch                Branch       @relation("BranchProductAssignment", fields: [branch_id], references: [id], onDelete: Cascade)
  product               Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category              Category?    @relation("BranchProductCategory", fields: [category_id], references: [id], onDelete: SetNull)
  brand                 Brand?       @relation("BranchProductBrand", fields: [brand_id], references: [id], onDelete: SetNull)
  source_branch         Branch?      @relation("BranchProductSource", fields: [source_branch_id], references: [id], onDelete: SetNull)
  user                  User?        @relation("BranchProductAddedBy", fields: [added_by_user_id], references: [id], onDelete: SetNull)

  @@unique([org_id, branch_id, product_id])
  @@index([org_id])
  @@index([branch_id])
  @@index([product_id])
  @@index([category_id])
  @@index([brand_id])
  @@index([branch_id, category_id])
  @@index([branch_id, brand_id])
  @@map("branch_products")
}

model CatalogImport {
  id                  String       @id @default(cuid())
  org_id              String
  source_branch_id    String
  target_branch_id    String
  imported_by_user_id String?
  product_count       Int
  copy_stock          Boolean      @default(false)
  notes               String?      @db.Text
  created_at          DateTime     @default(now())

  organization        Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  source_branch       Branch       @relation("ImportSource", fields: [source_branch_id], references: [id], onDelete: Cascade)
  target_branch       Branch       @relation("ImportTarget", fields: [target_branch_id], references: [id], onDelete: Cascade)
  user                User?        @relation("CatalogImportImportedBy", fields: [imported_by_user_id], references: [id], onDelete: SetNull)

  @@index([org_id])
  @@index([source_branch_id])
  @@index([target_branch_id])
  @@map("catalog_imports")
}

model Supplier {
  id                 String         @id @default(cuid())
  org_id             String
  name               String
  phone              String?
  email              String?
  address            String?        @db.Text
  contact_person     String?
  tax_id             String?
  notes              String?        @db.Text
  is_active          Boolean        @default(true)
  created_by_user_id String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  deleted_at         DateTime?

  organization       Organization   @relation(fields: [org_id], references: [id], onDelete: Cascade)
  created_by         User?          @relation("SupplierCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  stock_receipts     StockReceipt[]

  @@index([org_id])
  @@index([org_id, is_active])
  @@index([org_id, name])
  @@map("suppliers")
}

model StockReceipt {
  id                      String              @id @default(cuid())
  org_id                  String
  branch_id               String
  supplier_id             String
  reference               String
  receipt_date            DateTime            @default(now())
  supplier_invoice_number String?
  notes                   String?             @db.Text
  status                  String              @default("completed")
  created_by_user_id      String?
  received_by_user_id     String?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organization            Organization        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  branch                  Branch              @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  supplier                Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  created_by              User?               @relation("ReceiptCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  received_by             User?               @relation("ReceiptReceivedBy", fields: [received_by_user_id], references: [id], onDelete: SetNull)
  items                   StockReceiptItem[]
  stock_movements         StockMovement[]

  @@unique([org_id, reference])
  @@index([org_id, branch_id])
  @@index([org_id, supplier_id])
  @@index([org_id, receipt_date])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id                String          @id @default(cuid())
  stock_receipt_id  String
  product_id        String
  variant_id        String?
  quantity_received Decimal         @db.Decimal(14, 3)
  unit_cost         Decimal?        @db.Decimal(14, 2)
  notes             String?         @db.Text
  created_at        DateTime        @default(now())

  stock_receipt     StockReceipt    @relation(fields: [stock_receipt_id], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([stock_receipt_id])
  @@index([product_id])
  @@index([variant_id])
  @@map("stock_receipt_items")
}



